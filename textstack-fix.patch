diff --git a/CMakeLists.txt b/CMakeLists.txt
index d3c5ad3..f7a12af 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -89,7 +89,16 @@ if(OPTIONS_ENABLE_IPO)
 # Freetype (via vcpkg CONFIG)
 if(OTC_ENABLE_TTF)
-  find_package(Freetype CONFIG REQUIRED)
+  # Try modern CMake config package (vcpkg). If not found, fall back to module mode.
+  find_package(Freetype CONFIG QUIET)
+  if(NOT TARGET Freetype::Freetype)
+    find_package(Freetype REQUIRED)
+  endif()
+
   target_link_libraries(otc_textstack INTERFACE Freetype::Freetype)
   target_compile_definitions(otc_textstack INTERFACE OTC_ENABLE_TTF)
 endif()
@@ -98,7 +107,21 @@ if(OTC_ENABLE_TTF)
 # HarfBuzz (via vcpkg CONFIG)
 if(OTC_ENABLE_HARFBUZZ)
-  find_package(harfbuzz CONFIG REQUIRED)
+  # Try HarfBuzz from vcpkg via CONFIG
+  find_package(harfbuzz CONFIG QUIET)
+
+  # Prefer vcpkg imported target
+  if(TARGET harfbuzz::harfbuzz)
+    target_link_libraries(otc_textstack INTERFACE harfbuzz::harfbuzz)
+  elseif(TARGET harfbuzz)
+    target_link_libraries(otc_textstack INTERFACE harfbuzz)
+  else()
+    # Fallback: pkg-config
+    find_package(PkgConfig REQUIRED)
+    pkg_check_modules(HARFBUZZ REQUIRED harfbuzz)
+    target_include_directories(otc_textstack INTERFACE )
+    target_link_libraries(otc_textstack INTERFACE )
+  endif()
 
   target_compile_definitions(otc_textstack INTERFACE OTC_ENABLE_HARFBUZZ)
 endif()
